{
  "name": "list-to-csv",
  "displayName": "Data Toolkit for Developers",
  "description": "Convert lists, generate SQL, compare columns, count values, deduplicate, and build Excel formulas — built for data engineers.",
  "publisher": "sid-dev",
  "icon": "images/icon.png",
  "version": "1.1.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
    "galleryBanner": {
    "color": "#89cdd3"
  },
  "pricing": "Free",
  "contributes": {
    "commands": [
      {
        "command": "list-to-csv.openWebview",
        "title": "Data Toolkit: Open Toolkit",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.convert",
        "title": "Data Toolkit: Convert to CSV Format",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.convertToCommaLine",
        "title": "Data Toolkit: Convert to Comma Separated Line",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.generateSQLTable",
        "title": "Data Toolkit: Generate SQL Table from Selection",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.countValues",
        "title": "Data Toolkit: Count Value Occurrences (GROUP BY)",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.removeDuplicates",
        "title": "Data Toolkit: Remove Duplicate Lines",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.compareColumns",
        "title": "Data Toolkit: Compare Two Columns",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.lastUsedConfigurations",
        "title": "Data Toolkit: Repeat Last Conversion",
        "category": "Data Toolkit"
      },
      {
        "command": "list-to-csv.openSettings",
        "title": "Data Toolkit: Open Extension Settings",
        "category": "Data Toolkit"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "list-to-csv.openWebview",
          "when": "editorHasSelection",
          "group": "list-to-csv@1"
        },
        {
          "submenu": "list-to-csv.submenu",
          "when": "editorHasSelection",
          "group": "list-to-csv@2"
        }
      ],
      "list-to-csv.submenu": [
        {
          "command": "list-to-csv.convert",
          "group": "1_convert@1"
        },
        {
          "command": "list-to-csv.convertToCommaLine",
          "group": "1_convert@2"
        },
        {
          "command": "list-to-csv.generateSQLTable",
          "group": "1_convert@3"
        },
        {
          "command": "list-to-csv.countValues",
          "group": "2_analyze@1"
        },
        {
          "command": "list-to-csv.removeDuplicates",
          "group": "2_analyze@2"
        },
        {
          "command": "list-to-csv.compareColumns",
          "group": "2_analyze@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "list-to-csv.submenu",
        "label": "Data Toolkit"
      }
    ],
    "configuration": {
      "title": "Data Toolkit for Developers",
      "properties": {
        "list-to-csv.delimiter": {
          "type": "string",
          "default": ",",
          "description": "Character used to separate fields. Applies to the 'Convert to CSV Format' command."
        },
        "list-to-csv.includeHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Add a generated 'Column 1, Column 2, ...' header row. Applies to the 'Convert to CSV Format' command."
        },
        "list-to-csv.quoteAllFields": {
          "type": "boolean",
          "default": false,
          "description": "Quote every field, not just those containing the delimiter, quotes or newlines. Applies to the 'Convert to CSV Format' command."
        },
        "list-to-csv.escapeCharacter": {
          "type": "string",
          "default": "\"",
          "description": "Character used to quote fields. Quote characters inside a value are doubled. Applies to the 'Convert to CSV Format' command."
        },
        "list-to-csv.varcharSizing": {
          "type": "string",
          "enum": [
            "fixed",
            "fromSample"
          ],
          "enumDescriptions": [
            "Always VARCHAR(255). Safe default — generated DDL cannot be too narrow for data outside the pasted sample.",
            "Size each column to the widest sampled value, with headroom. Tighter schemas, but risks truncation if the sample is not representative."
          ],
          "default": "fixed",
          "description": "How VARCHAR column widths are chosen when generating SQL with type inference."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint-fix-custom": "eslint src --fix",
    "test": "vscode-test",
    "inspect-vsix": "node ./scripts/inspect-vsix.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddhantvirus/vscode-data-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/siddhantvirus/vscode-data-toolkit/issues"
  },
  "homepage": "https://github.com/siddhantvirus/vscode-data-toolkit#readme",
  "keywords": [
    "csv",
    "sql",
    "data engineer",
    "list",
    "dedup",
    "vlookup",
    "excel",
    "compare",
    "group by",
    "count",
    "formatter",
    "in clause",
    "create table"
  ]
}
