# Normalise text files to LF in the repository, regardless of a contributor's
# core.autocrlf setting. Working trees keep the platform's native endings, so
# this changes nothing on checkout — it only guarantees the stored form.
* text=auto

# Binaries must never be line-ending converted
*.png binary
*.ico binary
*.vsix binary

# Generated: collapsed by default in pull requests and excluded from language
# statistics. Deliberately not `-diff`, which would make git treat it as binary
# and hide dependency changes that are worth auditing.
package-lock.json linguist-generated
